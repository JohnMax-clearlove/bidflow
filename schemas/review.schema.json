{
  "$defs": {
    "FindingResolution": {
      "additionalProperties": true,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "basis": {
          "description": "关闭该发现的核对依据，不能只写“已修改”。",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "location": {
          "description": "当前正文或材料中的实际定位。",
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "section_sha256": {
          "default": "",
          "title": "Section Sha256",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "basis",
        "location"
      ],
      "title": "FindingResolution",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": true,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "稳定问题编号；由程序分配或沿用prior_open_findings。",
          "title": "Finding Id"
        },
        "state": {
          "default": "open",
          "enum": [
            "open",
            "resolved"
          ],
          "title": "State",
          "type": "string"
        },
        "resolution_refs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Resolution Refs",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message",
        "suggestion",
        "location"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "section_id": {
      "title": "Section Id",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "writer_id": {
      "minLength": 1,
      "title": "Writer Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "resolutions": {
      "description": "对历轮未关闭发现的复核关闭声明；由独立Reviewer提交。",
      "items": {
        "$ref": "#/$defs/FindingResolution"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "scores": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Scores",
      "type": "array"
    },
    "covered_subrequirements": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Reviewer逐条确认正文实际覆盖的评分子要求；不能照抄Writer自报结果。",
      "title": "Covered Subrequirements",
      "type": "object"
    },
    "status": {
      "enum": [
        "pass",
        "revise"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "section_id",
    "reviewer_id",
    "writer_id",
    "findings",
    "scores",
    "status"
  ],
  "title": "ReviewResult",
  "type": "object"
}
