{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "volume": {
          "description": "成品册ID或册名",
          "minLength": 1,
          "title": "Volume",
          "type": "string"
        },
        "page": {
          "description": "该册实际物理页，从1开始",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "volume",
        "page"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "risk",
            "uncertain",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Refs",
          "type": "array"
        },
        "parent_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Parent Refs",
          "type": "array"
        },
        "verified_original": {
          "default": false,
          "title": "Verified Original",
          "type": "boolean"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreClaim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "reason"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "ScoreClaim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "supported",
            "conditional",
            "simulated",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ScoreClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "lane": {
      "enum": [
        "human",
        "agent"
      ],
      "title": "Lane",
      "type": "string"
    },
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "attestation": {
      "default": "",
      "title": "Attestation",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "lane",
    "actor",
    "items"
  ],
  "title": "LaneResult",
  "type": "object"
}
